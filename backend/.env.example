# MongoDB
MONGODB_URI=mongodb://localhost:27017/mudgarvale

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Admin Email (only this email can add products)
ADMIN_EMAIL=admin@mudgarvale.com

# Nodemailer (for OTP emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (for payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Must match the secret configured in Razorpay Dashboard > Settings > Webhooks.
# This is separate from RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Order Settings
DELIVERY_CHARGE=100
COD_ADVANCE_AMOUNT=400

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
